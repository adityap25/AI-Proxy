# Server Configuration
ENV=production
PORT=8080

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=aidb

# AI Services
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:1b

# Semantic cache contract. The similarity threshold is cosine similarity, so
# 0.90 only reuses responses for prompts at least 90% semantically similar.
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL=24h
# Bump this when the application-level system prompt changes.
SYSTEM_PROMPT_VERSION=none
